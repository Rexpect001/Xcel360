# Database
DATABASE_URL="postgresql://user:password@localhost:5432/xcel360"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-nextauth-secret-here-generate-with-openssl-rand-base64-32"

# Google OAuth (optional)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Email (Nodemailer / SMTP)
EMAIL_SERVER_HOST="smtp.gmail.com"
EMAIL_SERVER_PORT="587"
EMAIL_SERVER_USER="your@email.com"
EMAIL_SERVER_PASSWORD="your-app-password"
EMAIL_FROM="Xcel360 <noreply@xcel360.com>"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="Xcel360"

# AI Agent (Anthropic Claude) - required for AI Auto-Post in admin
ANTHROPIC_API_KEY="sk-ant-..."
