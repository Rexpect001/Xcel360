# Database
DATABASE_URL="postgresql://user:password@localhost:5432/xcel360"
DIRECT_URL="postgresql://user:password@localhost:5432/xcel360"

# Azure Blob Storage (uploads, resources, generated images, and certificates)
AZURE_STORAGE_CONNECTION_STRING="DefaultEndpointsProtocol=https;AccountName=..."
AZURE_STORAGE_CONTAINER="xcel360-public"

# Protects scheduled HTTP jobs. Use a long random value and configure the same
# value in the Azure Logic Apps Authorization header.
CRON_SECRET="replace-with-a-long-random-secret"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-nextauth-secret-here-generate-with-openssl-rand-base64-32"

# Google OAuth (optional)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Email (Nodemailer / SMTP)
EMAIL_SERVER_HOST="smtp.gmail.com"
EMAIL_SERVER_PORT="587"
EMAIL_SERVER_USER="your@email.com"
EMAIL_SERVER_PASSWORD="your-app-password"
EMAIL_FROM="Xcel360 <noreply@thexcel360.com>"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="Xcel360"

# AI Agent (Anthropic Claude) - required for AI Auto-Post in admin
ANTHROPIC_API_KEY="sk-ant-..."

# ── Google AdSense (optional) ─────────────────────────────────────────────
# Publisher id - defaults to ours in src/lib/ads.ts; /ads.txt is generated from it.
# Ads load on public pages in production builds only. Each placement needs an ad
# unit slot id (or the DEFAULT one); without it, or when Google has no ad to show,
# the slot shows the Xcel360 house ad instead.
NEXT_PUBLIC_ADSENSE_CLIENT=ca-pub-7270136170155691
NEXT_PUBLIC_ADSENSE_SLOT_DEFAULT=      # fallback ad unit id for every placement
NEXT_PUBLIC_ADSENSE_SLOT_HOME=
NEXT_PUBLIC_ADSENSE_SLOT_LISTING=
NEXT_PUBLIC_ADSENSE_SLOT_INFEED=
NEXT_PUBLIC_ADSENSE_SLOT_DETAIL_TOP=
NEXT_PUBLIC_ADSENSE_SLOT_DETAIL_INLINE=
NEXT_PUBLIC_ADSENSE_SLOT_DETAIL_SIDEBAR=
NEXT_PUBLIC_ADS_DISABLED=              # set to true to switch all Google ads off

# ── Contact form + "Speak with an advisor" ────────────────────────────────
CONTACT_INBOX=hello@thexcel360.com     # where messages are forwarded (also saved in Activity Log)

# ── Video Hub (optional override) ─────────────────────────────────────────
YOUTUBE_CHANNEL_ID=UCQDkfEJrTQR6h6dAV1OUlvg

# Paystack (credits for AI tools). Use sk_test_... locally, sk_live_... in production.
# Webhook URL to set in the Paystack dashboard: https://thexcel360.com/api/billing/paystack/webhook
PAYSTACK_SECRET_KEY=""
