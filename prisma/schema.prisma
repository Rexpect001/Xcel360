generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  USER
  EDITOR
  MODERATOR
  MENTOR
  MANAGER
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DISABLED
}

enum ApplicationStatus {
  INTERESTED
  PREPARING
  SUBMITTED
  INTERVIEW
  RESULT
}

enum OpportunityStatus {
  OPEN
  CLOSED
}

enum OpportunityCategory {
  SCHOLARSHIP
  JOB
  INTERNSHIP
}

enum NotificationType {
  DEADLINE_REMINDER
  NEW_OPPORTUNITY
  APPLICATION_UPDATE
  GENERAL
}

model User {
  id            String     @id @default(cuid())
  email         String     @unique
  name          String?
  password      String?
  image         String?
  role          Role       @default(USER)
  status        UserStatus @default(ACTIVE)
  emailVerified DateTime?
  lastLoginAt   DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  profile       Profile?
  savedOpps     SavedOpportunity[]
  applications  Application[]
  notifications Notification[]
  accounts      Account[]
  sessions      Session[]
}

model Profile {
  id              String   @id @default(cuid())
  userId          String   @unique
  level           String?
  targetCountries String[]
  targetFields    String[]
  bio             String?
  whatsappNumber  String?
  school          String?
  department      String?
  notifyEmail     Boolean  @default(true)
  notifyInApp     Boolean  @default(true)
  reminderDays    Int[]    @default([30, 14, 7, 2])
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Opportunity {
  id              String               @id @default(cuid())
  title           String
  category        OpportunityCategory  @default(SCHOLARSHIP)
  programLevel    String[]
  field           String
  fieldTags       String[]
  country         String
  region          String?
  hostOrg         String
  fundingType     String
  deadline        DateTime?
  eligibility     String               @db.Text
  requiredDocs    String[]
  applicationLink String
  status          OpportunityStatus    @default(OPEN)
  featured        Boolean              @default(false)
  description     String?              @db.Text
  imageUrl        String?
  pdfUrl          String?
  views           Int                  @default(0)
  postedBy        String?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  // Job/Internship-specific fields
  jobType         String?
  salary          String?
  company         String?
  remote          Boolean              @default(false)
  experienceLevel String?
  skills          String[]

  savedBy      SavedOpportunity[]
  applications Application[]
}

model ToolPostActivity {
  id            String   @id @default(cuid())
  poster        String
  opportunityId String
  title         String
  category      String
  createdAt     DateTime @default(now())
}

model SavedOpportunity {
  id            String      @id @default(cuid())
  userId        String
  opportunityId String
  savedAt       DateTime    @default(now())

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  opportunity Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  @@unique([userId, opportunityId])
}

model Application {
  id            String            @id @default(cuid())
  userId        String
  opportunityId String
  status        ApplicationStatus @default(INTERESTED)
  notes         String?           @db.Text
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  opportunity Opportunity   @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  checklist   ChecklistItem[]

  @@unique([userId, opportunityId])
}

model ChecklistItem {
  id            String      @id @default(cuid())
  applicationId String
  item          String
  completed     Boolean     @default(false)
  createdAt     DateTime    @default(now())

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  message   String
  read      Boolean          @default(false)
  link      String?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Event {
  id            String              @id @default(cuid())
  title         String
  description   String?             @db.Text
  type          String
  date          DateTime
  link          String?
  host          String?
  coverImage    String?
  published     Boolean             @default(false)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  registrations EventRegistration[]
  questions     EventQuestion[]
  certificates  Certificate[]
  certTemplate  CertificateTemplate?
}

model EventRegistration {
  id            String        @id @default(cuid())
  eventId       String
  event         Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  fullName      String
  email         String
  phone         String?
  whatsappPhone String?
  createdAt     DateTime      @default(now())
  answers       EventAnswer[]
  certificates  Certificate[]

  @@index([eventId])
}

model EventQuestion {
  id        String        @id @default(cuid())
  eventId   String
  event     Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  label     String
  type      String        @default("text") // "text", "textarea", "select"
  options   String[]
  required  Boolean       @default(false)
  sortOrder Int           @default(0)
  answers   EventAnswer[]

  @@index([eventId])
}

model EventAnswer {
  id             String            @id @default(cuid())
  registrationId String
  registration   EventRegistration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  questionId     String
  question       EventQuestion     @relation(fields: [questionId], references: [id], onDelete: Cascade)
  answer         String            @db.Text

  @@index([registrationId])
  @@index([questionId])
}

model MentorshipOffering {
  id          String   @id @default(cuid())
  title       String
  description String?  @db.Text
  mentor      String
  expertise   String[]
  available   Boolean  @default(true)
  link        String?
  linkedIn    String?
  image       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model BlogPost {
  id         String   @id @default(cuid())
  title      String
  slug       String   @unique
  content    String   @db.Text
  excerpt    String?
  coverImage String?
  published  Boolean  @default(false)
  author     String
  tags       String[]
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model SuccessStory {
  id         String   @id @default(cuid())
  name       String
  scholarship String
  university String
  quote      String
  image      String?
  year       Int?
  published  Boolean  @default(false)
  createdAt  DateTime @default(now())
}

model EmailSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}

// Master contacts list — aggregates all contact sources
model Contact {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  source    String   @default("import") // 'import' | 'event' | 'user' | 'subscriber'
  tags      String[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Admin email campaigns — supports batched sending across multiple days
model EmailCampaign {
  id               String   @id @default(cuid())
  subject          String
  htmlBody         String   @db.Text
  textBody         String?  @db.Text          // plain text body — used when provider is sendchamp
  audience         String   // 'users' | 'subscribers' | 'both' | 'none'
  provider         String   @default("resend") // 'resend' | 'sendchamp'
  status           String   @default("DRAFT") // DRAFT | SENDING | COMPLETED | FAILED
  recipients       String   @db.Text          // JSON array of all To addresses (merged at send time)
  manualRecipients String   @default("[]") @db.Text // JSON array — raw manual To chips
  ccRecipients     String   @default("[]") @db.Text // JSON array of CC addresses
  bccRecipients    String   @default("[]") @db.Text // JSON array of BCC addresses
  attachments      String   @default("[]") @db.Text // JSON array of {filename,url,contentType,size}
  totalCount       Int      @default(0)
  sentCount        Int      @default(0)
  dailyLimit       Int      @default(100)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model EmailLog {
  id         String   @id @default(cuid())
  campaignId String
  to         String
  status     String   // SENT | FAILED
  error      String?
  sentAt     DateTime @default(now())

  @@index([campaignId])
}

model EmailTemplate {
  id        String   @id @default(cuid())
  name      String
  subject   String
  htmlBody  String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model EmailUnsubscribe {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}

// Downloadable resources & templates managed from admin
model Resource {
  id          String   @id @default(cuid())
  title       String
  description String?  @db.Text
  category    String   // "CV Template", "SOP Template", "Guide", etc.
  fileUrl     String   // Vercel Blob URL or external link
  filename    String?  // Suggested filename when downloaded
  fileSize    Int?     // File size in bytes
  fileType    String?  // MIME type: application/pdf, application/vnd.openxmlformats...
  isUploaded  Boolean  @default(false) // true = stored in Vercel Blob, false = external link
  downloads   Int      @default(0)
  published   Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Cohort mentorship programs run by Xcel360
model Program {
  id           String        @id @default(cuid())
  title        String        // e.g. "Cohort 1 — Mentorship Program"
  cohortNumber Int?          // 1, 2, 3 ...
  description  String        @db.Text
  focus        String        // e.g. "Scholarship Applications & SOP Writing"
  startDate    DateTime
  endDate      DateTime?
  participants Int           @default(0)
  published    Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  beneficiaries Beneficiary[]
}

// Participants in cohort programs — first name only shown publicly
model Beneficiary {
  id         String   @id @default(cuid())
  firstName  String
  department String?
  school     String?
  programId  String?
  program    Program? @relation(fields: [programId], references: [id], onDelete: SetNull)
  createdAt  DateTime @default(now())
}

model ActivityLog {
  id           String   @id @default(cuid())
  userId       String?
  userEmail    String?
  userRole     String?
  action       String   // CREATE, UPDATE, DELETE, PUBLISH, UNPUBLISH, LOGIN, LOGIN_FAILED, SIGNUP, ASSIGN_ROLE, etc.
  resource     String?  // opportunity, blog, event, user, mentor, program, resource
  resourceId   String?
  resourceName String?
  details      String?  @db.Text
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([resource])
  @@index([createdAt])
}

// NextAuth models
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model SiteSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}

// ─── Certificate Generation Module ───────────────────────────────────────────

enum CertificateStatus {
  ISSUED
  REVOKED
}

// One generated certificate, always linked to the original event + registration.
model Certificate {
  id              String            @id @default(cuid())
  certificateId   String            @unique // human ID, e.g. XCL360-2026-000001
  eventId         String
  event           Event             @relation(fields: [eventId], references: [id], onDelete: Cascade)
  registrationId  String
  registration    EventRegistration @relation(fields: [registrationId], references: [id], onDelete: Cascade)

  // Snapshot of registrant data at issue time (kept for the printed PDF & verification)
  fullName        String
  email           String
  institution     String?
  course          String?

  certificateType String            @default("Certificate of Participation")
  status          CertificateStatus @default(ISSUED)
  pdfUrl          String?           // Vercel Blob URL of the generated PDF
  emailSentAt     DateTime?
  issuedAt        DateTime          @default(now())
  revokedAt       DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@unique([eventId, registrationId]) // one active certificate per registration per event
  @@index([eventId])
  @@index([email])
}

// Per-event certificate design. eventId null = global default template.
model CertificateTemplate {
  id              String   @id @default(cuid())
  eventId         String?  @unique
  event           Event?   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  certificateType String   @default("Certificate of Participation")
  backgroundUrl   String?  // full-page background image (PNG/JPG)
  logoUrl         String?  // organization logo
  signatureUrl    String?  // signature image
  signatureName   String?  // e.g. "Dr. Jane Doe"
  signatureTitle  String?  // e.g. "Program Director"
  bodyText        String?  @db.Text // supports {{FULL_NAME}}, {{EVENT_NAME}}, {{EVENT_DATE}}, {{CERTIFICATE_ID}}, {{ISSUE_DATE}}
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// Short-lived OTP codes for participant certificate access.
model CertificateOtp {
  id        String   @id @default(cuid())
  email     String
  code      String
  expiresAt DateTime
  consumed  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([email])
}

// Per-year sequential counter for human-readable certificate IDs.
model CertificateSequence {
  year String @id // "2026"
  seq  Int    @default(0)
}
